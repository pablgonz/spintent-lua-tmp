          \str_if_eq:VnTF \l__spintent_luaset_has_units_str { true }
            { \msg_error:nnn { spintent } { spnum-has-units } { #2 } }
            {
              \tl_if_empty:NTF \l__spintent_luaset_part_int_tl
                { \msg_error:nnn { spintent } { spnum-no-digits } { #2 } }
                { \__spintent_spnum_print_number_core: }
