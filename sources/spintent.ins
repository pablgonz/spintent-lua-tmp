% Stop docstrip adding \endinput (from l3doc.dtx)
\postamble
\endpostamble
\usedir{tex/lualatex/spintent}
% Extraemos el paquete spintent.sty
\generate{\file{spintent.sty}{\from{spintent.dtx}{package}}}
% Apagamos el preámbulo y postámbulo
\nopreamble
\nopostamble
% Extraemos spintent.lua, mylhmc.lua y mylhmc.sty
\generate{
  \file{spintent.lua}{\from{spintent.dtx}{spintentlua}}
  \file{mylhmc.sty}{\from{spintent.dtx}{mylhmcsty}}
  \file{mylhmc.lua}{\from{spintent.dtx}{mylhmclua}}
}
