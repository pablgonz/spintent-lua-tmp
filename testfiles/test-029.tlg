              id="ID.00588"
              intent="_o"
              lspace="0.222em"
              rspace="0.222em"
             >
            <?MarkedContent page="1" ?>∪
           </mo>
           <mi xmlns="http://www.w3.org/1998/Math/MathML"
              id="ID.00589"
             >
            <?MarkedContent page="1" ?>𝐵
