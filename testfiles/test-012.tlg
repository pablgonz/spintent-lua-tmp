         <mover xmlns="http://www.w3.org/1998/Math/MathML"
            id="ID.01141"
           >
          <mi xmlns="http://www.w3.org/1998/Math/MathML"
             id="ID.01142"
             arg="pt"
             intent="_-"
            >
           <?MarkedContent page="3" ?>𝑎
          </mi>
          <mo xmlns="http://www.w3.org/1998/Math/MathML"
             id="ID.01143"
             stretchy="false"
            >
           <?MarkedContent page="3" ?>→
          </mo>
         </mover>
        </mrow>
        <mo xmlns="http://www.w3.org/1998/Math/MathML"
           id="ID.01144"
           intent=":silent"
           lspace="0.278em"
           rspace="0.278em"
          >
         <?MarkedContent page="3" ?>=
        </mo>
        <mi xmlns="http://www.w3.org/1998/Math/MathML"
           id="ID.01145"
           intent=":silent"
           mathvariant="normal"
          >
         <?MarkedContent page="3" ?>⁣
        </mi>
        <mrow xmlns="http://www.w3.org/1998/Math/MathML"
           id="ID.01146"
           intent="_-"
          >
         <mo xmlns="http://www.w3.org/1998/Math/MathML"
            id="ID.01147"
            lspace="0"
            rspace="0"
            stretchy="false"
           >
          <?MarkedContent page="3" ?>(
         </mo>
         <mo xmlns="http://www.w3.org/1998/Math/MathML"
            id="ID.01148"
            lspace="0"
            rspace="0"
           >
          <?MarkedContent page="3" ?>−
         </mo>
         <mn xmlns="http://www.w3.org/1998/Math/MathML"
            id="ID.01149"
           >
          <?MarkedContent page="3" ?>3
         </mn>
         <mo xmlns="http://www.w3.org/1998/Math/MathML"
            id="ID.01150"
            lspace="0"
            rspace="0.167em"
           >
          <?MarkedContent page="3" ?>,
         </mo>
         <mn xmlns="http://www.w3.org/1998/Math/MathML"
            id="ID.01151"
           >
          <?MarkedContent page="3" ?>4
         </mn>
         <mo xmlns="http://www.w3.org/1998/Math/MathML"
            id="ID.01152"
            lspace="0"
            rspace="0"
            stretchy="false"
           >
          <?MarkedContent page="3" ?>)
         </mo>
        </mrow>
       </math>
       <?MarkedContent page="3" ?>
