        rolemaps-to="P"
       >
      <?MarkedContent page="3" ?>80. Con todas las llaves: 
      <Formula xmlns="http://iso.org/pdf2/ssn"
         id="ID.01155"
         title="math"
         xmlns:Layout="http://iso.org/pdf/ssn/Layout"
         Layout:Placement="Inline"
        >
       <math xmlns="http://www.w3.org/1998/Math/MathML"
          id="ID.01158"
         >
        <mi xmlns="http://www.w3.org/1998/Math/MathML"
           id="ID.01159"
           intent=":silent"
           mathvariant="normal"
          >
         <?MarkedContent page="3" ?>⁣
        </mi>
        <msub xmlns="http://www.w3.org/1998/Math/MathML"
           id="ID.01160"
          >
         <mrow xmlns="http://www.w3.org/1998/Math/MathML"
            id="ID.01161"
            intent="_el-vector:prefix($pt)"
           >
          <mi xmlns="http://www.w3.org/1998/Math/MathML"
             id="ID.01162"
             intent=":silent"
             mathvariant="normal"
            >
           <?MarkedContent page="3" ?>⁣
          </mi>
          <mover xmlns="http://www.w3.org/1998/Math/MathML"
             id="ID.01163"
            >
           <mrow xmlns="http://www.w3.org/1998/Math/MathML"
              id="ID.01164"
             >
            <mpadded xmlns="http://www.w3.org/1998/Math/MathML"
               id="ID.01165"
               width="0"
              >
             <mphantom xmlns="http://www.w3.org/1998/Math/MathML"
                id="ID.01156"
               >
              <mi xmlns="http://www.w3.org/1998/Math/MathML"
                 id="ID.01157"
                >
              </mi>
             </mphantom>
            </mpadded>
            <mi xmlns="http://www.w3.org/1998/Math/MathML"
               id="ID.01166"
               arg="pt"
              >
             <?MarkedContent page="3" ?>𝑎
            </mi>
           </mrow>
           <mo xmlns="http://www.w3.org/1998/Math/MathML"
              id="ID.01167"
              stretchy="false"
             >
            <?MarkedContent page="3" ?>→
           </mo>
          </mover>
         </mrow>
         <mn xmlns="http://www.w3.org/1998/Math/MathML"
            id="ID.01168"
           >
          <?MarkedContent page="3" ?>1
         </mn>
        </msub>
        <mo xmlns="http://www.w3.org/1998/Math/MathML"
           id="ID.01169"
           lspace="0.278em"
           rspace="0.278em"
          >
         <?MarkedContent page="3" ?>=
        </mo>
        <mi xmlns="http://www.w3.org/1998/Math/MathML"
           id="ID.01170"
           intent=":silent"
           mathvariant="normal"
          >
         <?MarkedContent page="3" ?>⁣
        </mi>
        <mo xmlns="http://www.w3.org/1998/Math/MathML"
           id="ID.01171"
           intent=":silent"
           lspace="0"
           rspace="0"
           stretchy="false"
          >
         <?MarkedContent page="3" ?>(
        </mo>
        <mrow xmlns="http://www.w3.org/1998/Math/MathML"
           id="ID.01172"
           intent="_punto-y-coma:infix($x,$y)"
          >
         <mrow xmlns="http://www.w3.org/1998/Math/MathML"
            id="ID.01173"
            arg="x"
           >
          <mi xmlns="http://www.w3.org/1998/Math/MathML"
             id="ID.01174"
             intent=":silent"
             mathvariant="normal"
            >
           <?MarkedContent page="3" ?>⁣
          </mi>
          <mrow xmlns="http://www.w3.org/1998/Math/MathML"
             id="ID.01175"
             intent="3:number:prefix($next)"
            >
           <mn xmlns="http://www.w3.org/1998/Math/MathML"
              id="ID.01176"
             >
            <?MarkedContent page="3" ?>3
           </mn>
           <mrow xmlns="http://www.w3.org/1998/Math/MathML"
              id="ID.01177"
              arg="next"
              intent="_coma:prefix($dp)"
             >
            <mi xmlns="http://www.w3.org/1998/Math/MathML"
               id="ID.01178"
               mathvariant="normal"
              >
             <?MarkedContent page="3" ?>,
            </mi>
            <mrow xmlns="http://www.w3.org/1998/Math/MathML"
               id="ID.01179"
               arg="dp"
              >
             <mi xmlns="http://www.w3.org/1998/Math/MathML"
                id="ID.01180"
                intent=":silent"
                mathvariant="normal"
               >
              <?MarkedContent page="3" ?>⁣
             </mi>
             <mn xmlns="http://www.w3.org/1998/Math/MathML"
                id="ID.01181"
                intent="5:number"
               >
              <?MarkedContent page="3" ?>5
             </mn>
            </mrow>
           </mrow>
          </mrow>
         </mrow>
         <mo xmlns="http://www.w3.org/1998/Math/MathML"
            id="ID.01182"
            intent=":silent"
            lspace="0"
            rspace="0.167em"
           >
          <?MarkedContent page="3" ?>;
         </mo>
         <mrow xmlns="http://www.w3.org/1998/Math/MathML"
            id="ID.01183"
            arg="y"
            intent="4:number:prefix($next)"
           >
          <mn xmlns="http://www.w3.org/1998/Math/MathML"
             id="ID.01184"
            >
           <?MarkedContent page="3" ?>4
          </mn>
          <mrow xmlns="http://www.w3.org/1998/Math/MathML"
             id="ID.01185"
             arg="next"
             intent="_coma:prefix($dp)"
            >
           <mi xmlns="http://www.w3.org/1998/Math/MathML"
              id="ID.01186"
              mathvariant="normal"
             >
            <?MarkedContent page="3" ?>,
           </mi>
           <mrow xmlns="http://www.w3.org/1998/Math/MathML"
              id="ID.01187"
              arg="dp"
             >
            <mi xmlns="http://www.w3.org/1998/Math/MathML"
               id="ID.01188"
               intent=":silent"
               mathvariant="normal"
              >
             <?MarkedContent page="3" ?>⁣
            </mi>
            <mn xmlns="http://www.w3.org/1998/Math/MathML"
               id="ID.01189"
               intent="2:number"
              >
             <?MarkedContent page="3" ?>2
            </mn>
           </mrow>
          </mrow>
         </mrow>
        </mrow>
        <mo xmlns="http://www.w3.org/1998/Math/MathML"
           id="ID.01190"
           intent=":silent"
           lspace="0"
           rspace="0"
           stretchy="false"
          >
         <?MarkedContent page="3" ?>)
        </mo>
       </math>
       <?MarkedContent page="3" ?>
      </Formula>
      <?MarkedContent page="3" ?>.
     </text-block>
    </semantic-para>
   </section>
   <section xmlns="https://www.latex-project.org/ns/dflt"
      id="ID.01191"
      rolemaps-to="Sect"
     >
