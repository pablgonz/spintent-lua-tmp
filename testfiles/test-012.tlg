    </semantic-para>
    <semantic-para xmlns="https://www.latex-project.org/ns/dflt"
       id="ID.01215"
       rolemaps-to="Part"
      >
     <text-block xmlns="https://www.latex-project.org/ns/dflt"
        id="ID.01216"
        xmlns:Layout="http://iso.org/pdf/ssn/Layout"
        Layout:TextAlign="Justify"
        rolemaps-to="P"
       >
      <?MarkedContent page="3" ?>82. Igualdad de vectores: 
      <Formula xmlns="http://iso.org/pdf2/ssn"
         id="ID.01217"
         title="math"
         xmlns:Layout="http://iso.org/pdf/ssn/Layout"
         Layout:Placement="Inline"
        >
       <?MarkedContent page="3" ?>
       <math xmlns="http://www.w3.org/1998/Math/MathML"
          id="ID.01218"
         >
        <mi xmlns="http://www.w3.org/1998/Math/MathML"
           id="ID.01219"
           intent=":silent"
           mathvariant="normal"
          >
         <?MarkedContent page="3" ?>⁣
        </mi>
        <mrow xmlns="http://www.w3.org/1998/Math/MathML"
           id="ID.01220"
           intent="_vector:prefix($pts1,$pts2)"
          >
         <mi xmlns="http://www.w3.org/1998/Math/MathML"
            id="ID.01221"
            intent=":silent"
            mathvariant="normal"
           >
          <?MarkedContent page="3" ?>⁣
         </mi>
         <mover xmlns="http://www.w3.org/1998/Math/MathML"
            id="ID.01222"
           >
          <mrow xmlns="http://www.w3.org/1998/Math/MathML"
             id="ID.01223"
            >
           <mi xmlns="http://www.w3.org/1998/Math/MathML"
              id="ID.01224"
              arg="pts1"
              intent="_A-"
             >
            <?MarkedContent page="3" ?>𝐴
           </mi>
           <mi xmlns="http://www.w3.org/1998/Math/MathML"
              id="ID.01225"
              arg="pts2"
              intent="_B-"
             >
            <?MarkedContent page="3" ?>𝐵
           </mi>
          </mrow>
          <mo xmlns="http://www.w3.org/1998/Math/MathML"
             id="ID.01226"
            >
           <?MarkedContent page="3" ?>→
          </mo>
         </mover>
        </mrow>
        <mo xmlns="http://www.w3.org/1998/Math/MathML"
           id="ID.01227"
           lspace="0.278em"
           rspace="0.278em"
          >
         <?MarkedContent page="3" ?>=
        </mo>
        <mrow xmlns="http://www.w3.org/1998/Math/MathML"
           id="ID.01228"
           intent="_vector:prefix($pts1,$pts2)"
          >
         <mi xmlns="http://www.w3.org/1998/Math/MathML"
            id="ID.01229"
            intent=":silent"
            mathvariant="normal"
           >
          <?MarkedContent page="3" ?>⁣
         </mi>
         <mover xmlns="http://www.w3.org/1998/Math/MathML"
            id="ID.01230"
           >
          <mrow xmlns="http://www.w3.org/1998/Math/MathML"
             id="ID.01231"
            >
           <mi xmlns="http://www.w3.org/1998/Math/MathML"
              id="ID.01232"
              arg="pts1"
              intent="_C-"
             >
            <?MarkedContent page="3" ?>𝐶
           </mi>
           <mi xmlns="http://www.w3.org/1998/Math/MathML"
              id="ID.01233"
              arg="pts2"
              intent="_D-"
             >
            <?MarkedContent page="3" ?>𝐷
           </mi>
          </mrow>
          <mo xmlns="http://www.w3.org/1998/Math/MathML"
             id="ID.01234"
            >
           <?MarkedContent page="3" ?>→
          </mo>
         </mover>
        </mrow>
       </math>
       <?MarkedContent page="3" ?>
      </Formula>
      <?MarkedContent page="3" ?>.
     </text-block>
    </semantic-para>
    <semantic-para xmlns="https://www.latex-project.org/ns/dflt"
       id="ID.01235"
       rolemaps-to="Part"
      >
     <text-block xmlns="https://www.latex-project.org/ns/dflt"
        id="ID.01236"
        xmlns:Layout="http://iso.org/pdf/ssn/Layout"
        Layout:TextAlign="Justify"
        rolemaps-to="P"
       >
      <?MarkedContent page="3" ?>83. Tres vectores con coordenadas, cada uno en su fórmula: 
      <Formula xmlns="http://iso.org/pdf2/ssn"
         id="ID.01237"
         title="math"
         xmlns:Layout="http://iso.org/pdf/ssn/Layout"
         Layout:Placement="Inline"
        >
       <?MarkedContent page="3" ?>
       <math xmlns="http://www.w3.org/1998/Math/MathML"
          id="ID.01238"
         >
        <mi xmlns="http://www.w3.org/1998/Math/MathML"
           id="ID.01239"
           intent=":silent"
           mathvariant="normal"
          >
         <?MarkedContent page="3" ?>⁣
        </mi>
        <mrow xmlns="http://www.w3.org/1998/Math/MathML"
           id="ID.01240"
           intent="_vector:prefix($pt)"
          >
         <mi xmlns="http://www.w3.org/1998/Math/MathML"
            id="ID.01241"
            intent=":silent"
            mathvariant="normal"
           >
          <?MarkedContent page="3" ?>⁣
         </mi>
         <mover xmlns="http://www.w3.org/1998/Math/MathML"
            id="ID.01242"
           >
          <mi xmlns="http://www.w3.org/1998/Math/MathML"
             id="ID.01243"
             arg="pt"
             intent="_a-"
            >
           <?MarkedContent page="3" ?>𝑎
          </mi>
          <mo xmlns="http://www.w3.org/1998/Math/MathML"
             id="ID.01244"
             stretchy="false"
            >
           <?MarkedContent page="3" ?>→
          </mo>
         </mover>
        </mrow>
        <mo xmlns="http://www.w3.org/1998/Math/MathML"
           id="ID.01245"
           lspace="0.278em"
           rspace="0.278em"
          >
         <?MarkedContent page="3" ?>=
        </mo>
        <mi xmlns="http://www.w3.org/1998/Math/MathML"
           id="ID.01246"
           intent=":silent"
           mathvariant="normal"
          >
         <?MarkedContent page="3" ?>⁣
        </mi>
        <mo xmlns="http://www.w3.org/1998/Math/MathML"
           id="ID.01247"
           intent=":silent"
           lspace="0"
           rspace="0"
           stretchy="false"
          >
         <?MarkedContent page="3" ?>(
        </mo>
        <mrow xmlns="http://www.w3.org/1998/Math/MathML"
           id="ID.01248"
           intent="_coma:infix($x,$y)"
          >
         <mn xmlns="http://www.w3.org/1998/Math/MathML"
            id="ID.01249"
            arg="x"
            intent="1:number"
           >
          <?MarkedContent page="3" ?>1
         </mn>
         <mo xmlns="http://www.w3.org/1998/Math/MathML"
            id="ID.01250"
            intent=":silent"
            lspace="0"
            rspace="0.167em"
           >
          <?MarkedContent page="3" ?>,
         </mo>
         <mn xmlns="http://www.w3.org/1998/Math/MathML"
            id="ID.01251"
            arg="y"
            intent="2:number"
           >
          <?MarkedContent page="3" ?>2
         </mn>
        </mrow>
        <mo xmlns="http://www.w3.org/1998/Math/MathML"
           id="ID.01252"
           intent=":silent"
           lspace="0"
           rspace="0"
           stretchy="false"
          >
         <?MarkedContent page="3" ?>)
        </mo>
       </math>
       <?MarkedContent page="3" ?>
      </Formula>
      <?MarkedContent page="3" ?>, 
      <Formula xmlns="http://iso.org/pdf2/ssn"
         id="ID.01253"
         title="math"
         xmlns:Layout="http://iso.org/pdf/ssn/Layout"
         Layout:Placement="Inline"
