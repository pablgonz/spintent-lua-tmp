       id="ID.01192"
       title="H. En fórmulas"
       rolemaps-to="H1"
      >
     <?MarkedContent page="3" ?>H. En fórmulas
    </section-heading>
    <semantic-para xmlns="https://www.latex-project.org/ns/dflt"
       id="ID.01193"
       rolemaps-to="Part"
      >
     <text-block xmlns="https://www.latex-project.org/ns/dflt"
        id="ID.01194"
        xmlns:Layout="http://iso.org/pdf/ssn/Layout"
        Layout:TextAlign="Justify"
        rolemaps-to="P"
       >
      <?MarkedContent page="3" ?>81. Suma de vectores: 
      <Formula xmlns="http://iso.org/pdf2/ssn"
         id="ID.01195"
         title="math"
         xmlns:Layout="http://iso.org/pdf/ssn/Layout"
         Layout:Placement="Inline"
        >
       <?MarkedContent page="3" ?>
       <math xmlns="http://www.w3.org/1998/Math/MathML"
          id="ID.01196"
         >
        <mi xmlns="http://www.w3.org/1998/Math/MathML"
           id="ID.01197"
           intent=":silent"
           mathvariant="normal"
          >
         <?MarkedContent page="3" ?>⁣
        </mi>
        <mrow xmlns="http://www.w3.org/1998/Math/MathML"
           id="ID.01198"
           intent="_vector:prefix($pt)"
          >
         <mi xmlns="http://www.w3.org/1998/Math/MathML"
            id="ID.01199"
            intent=":silent"
            mathvariant="normal"
           >
          <?MarkedContent page="3" ?>⁣
         </mi>
         <mover xmlns="http://www.w3.org/1998/Math/MathML"
            id="ID.01200"
           >
          <mi xmlns="http://www.w3.org/1998/Math/MathML"
             id="ID.01201"
             arg="pt"
             intent="_a-"
            >
           <?MarkedContent page="3" ?>𝑎
          </mi>
          <mo xmlns="http://www.w3.org/1998/Math/MathML"
             id="ID.01202"
             stretchy="false"
            >
           <?MarkedContent page="3" ?>→
          </mo>
         </mover>
        </mrow>
        <mo xmlns="http://www.w3.org/1998/Math/MathML"
           id="ID.01203"
           lspace="0.222em"
           rspace="0.222em"
          >
         <?MarkedContent page="3" ?>+
        </mo>
        <mrow xmlns="http://www.w3.org/1998/Math/MathML"
           id="ID.01204"
           intent="_vector:prefix($pt)"
          >
         <mi xmlns="http://www.w3.org/1998/Math/MathML"
            id="ID.01205"
            intent=":silent"
            mathvariant="normal"
           >
          <?MarkedContent page="3" ?>⁣
         </mi>
         <mover xmlns="http://www.w3.org/1998/Math/MathML"
            id="ID.01206"
           >
          <mi xmlns="http://www.w3.org/1998/Math/MathML"
             id="ID.01207"
             arg="pt"
             intent="_b-"
            >
           <?MarkedContent page="3" ?>𝑏
          </mi>
          <mo xmlns="http://www.w3.org/1998/Math/MathML"
             id="ID.01208"
             stretchy="false"
            >
           <?MarkedContent page="3" ?>→
          </mo>
         </mover>
        </mrow>
        <mo xmlns="http://www.w3.org/1998/Math/MathML"
           id="ID.01209"
           lspace="0.278em"
           rspace="0.278em"
          >
         <?MarkedContent page="3" ?>=
        </mo>
        <mrow xmlns="http://www.w3.org/1998/Math/MathML"
           id="ID.01210"
           intent="_vector:prefix($pt)"
          >
         <mi xmlns="http://www.w3.org/1998/Math/MathML"
            id="ID.01211"
            intent=":silent"
            mathvariant="normal"
           >
          <?MarkedContent page="3" ?>⁣
         </mi>
         <mover xmlns="http://www.w3.org/1998/Math/MathML"
            id="ID.01212"
           >
          <mi xmlns="http://www.w3.org/1998/Math/MathML"
             id="ID.01213"
             arg="pt"
             intent="_c-"
            >
           <?MarkedContent page="3" ?>𝑐
          </mi>
          <mo xmlns="http://www.w3.org/1998/Math/MathML"
             id="ID.01214"
             stretchy="false"
            >
           <?MarkedContent page="3" ?>→
          </mo>
         </mover>
        </mrow>
