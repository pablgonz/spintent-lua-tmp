           id="ID.00874"
           intent=":silent"
           mathvariant="normal"
          >
         <?MarkedContent page="2" ?>⁣
        </mi>
        <mrow xmlns="http://www.w3.org/1998/Math/MathML"
           id="ID.00875"
           intent="_vector:prefix($pt)"
          >
