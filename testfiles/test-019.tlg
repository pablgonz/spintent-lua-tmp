           id="ID.00346"
           intent=":silent"
           lspace="0"
           rspace="0"
           stretchy="false"
          >
         <?MarkedContent page="1" ?>(
        </mo>
        <mrow xmlns="http://www.w3.org/1998/Math/MathML"
           id="ID.00347"
           intent="_coma:infix($x,$y)"
          >
         <mn xmlns="http://www.w3.org/1998/Math/MathML"
            id="ID.00348"
            arg="x"
            intent="1:number"
           >
          <?MarkedContent page="1" ?>1
