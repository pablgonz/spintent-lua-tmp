            id="ID.00479"
            lspace="0"
            rspace="0"
            stretchy="false"
           >
          <?MarkedContent page="2" ?>(
         </mo>
         <mrow xmlns="http://www.w3.org/1998/Math/MathML"
            id="ID.00480"
            arg="a"
           >
          <mi xmlns="http://www.w3.org/1998/Math/MathML"
             id="ID.00481"
             intent=":silent"
             mathvariant="normal"
            >
           <?MarkedContent page="2" ?>⁣
          </mi>
          <mi xmlns="http://www.w3.org/1998/Math/MathML"
             id="ID.00482"
            >
           <?MarkedContent page="2" ?>𝐴
          </mi>
         </mrow>
         <mo xmlns="http://www.w3.org/1998/Math/MathML"
            id="ID.00483"
            lspace="0"
            rspace="0"
            stretchy="false"
           >
          <?MarkedContent page="2" ?>)
         </mo>
        </mrow>
        <mo xmlns="http://www.w3.org/1998/Math/MathML"
           id="ID.00484"
           lspace="0.278em"
           rspace="0.278em"
          >
         <?MarkedContent page="2" ?>=
