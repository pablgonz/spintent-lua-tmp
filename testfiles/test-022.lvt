% test-022.tex -- comandos \spfun (inversa), \spdom, \sprec y \spcod
%
% Regresion:  l3build save test-022
%             l3build check test-022
%
% \spfun acepta la funcion inversa: f^{-1}(x), f_{1}^{-1}(x) y, sin
% parentesis, f^{-1}. \spdom, \sprec y \spcod escriben Dom(f), Rec(f) y
% Cod(f); su argumento es solo el nombre de una funcion (letra con
% subindice o primas, y el exponente ^{-1}).
% Las entradas invalidas (que detienen la compilacion) no van aqui.
%
% Los "doc:" son lecturas reales de NVDA con MathCAT (2026-10-08).
% La de read-cmd=mathcat (caso 20) es una lectura propia de MathCAT, no del
% paquete. La inversa dentro de un argumento (caso 17) usa la recursion de
% \spfun; ver test-023.
\input{regression-test}

