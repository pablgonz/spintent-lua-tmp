% test-013.lvt -- regresion de \sprecta, \sprayo, \spside y \spmside
%
% Regresion:  l3build save test-013
%             l3build check test-013
%
% Las lecturas esperadas de NVDA estan en tagged-test/test-013.tex.
%
% Cada caso es un parrafo numerado, para ubicarlo en el diff del .tlg.
% Todos trabajan en modo matematico. \sprecta recibe una letra o dos
% puntos; \sprayo, \spside y \spmside, dos puntos. Un punto es una letra
% mayuscula con prima o con subindice entre llaves. Las entradas invalidas
% (que detienen la compilacion) no van aqui, entre ellas dos letras
% minusculas juntas y A_1 sin llaves.
\input{regression-test}

