%% test-100.lvt -- mensajes de error y de aviso de spintent
%%
%% Regresion:  l3build save test-100
%%             l3build check test-100
%%
%% Cada caso va en su propio parrafo y precedido por \TYPE{[id]} para que
%% el .tlg indique que mensaje corresponde a cada entrada. Un parrafo por
%% caso reinicia el contador de errores de TeX (limite de 100 seguidos).
%% Los casos se agregan siempre al final de su seccion.
%% Las entradas de los casos son las previstas segun el codigo; si alguna
%% no produce el mensaje esperado, corregir la entrada y volver a guardar.
\input{regression-test}

\DocumentMetadata
  {
    lang=es-CL,
    pdfversion=2.0,
    pdfstandard=ua-2,
    tagging=on,
    tagging-setup={math/setup={mathml-SE}},
  }
