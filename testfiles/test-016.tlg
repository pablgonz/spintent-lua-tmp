    <semantic-para xmlns="https://www.latex-project.org/ns/dflt"
       id="ID.02589"
       rolemaps-to="Part"
      >
     <text-block xmlns="https://www.latex-project.org/ns/dflt"
        id="ID.02590"
        xmlns:Layout="http://iso.org/pdf/ssn/Layout"
        Layout:TextAlign="Justify"
        rolemaps-to="P"
       >
      <?MarkedContent page="6" ?>210. Área y perímetro de la misma circunferencia: 
      <Formula xmlns="http://iso.org/pdf2/ssn"
         id="ID.02591"
         title="math"
         xmlns:Layout="http://iso.org/pdf/ssn/Layout"
         Layout:Placement="Inline"
        >
       <?MarkedContent page="6" ?>
       <math xmlns="http://www.w3.org/1998/Math/MathML"
          id="ID.02592"
         >
        <mi xmlns="http://www.w3.org/1998/Math/MathML"
           id="ID.02593"
           intent=":silent"
           mathvariant="normal"
          >
         <?MarkedContent page="6" ?>⁣
        </mi>
        <mrow xmlns="http://www.w3.org/1998/Math/MathML"
           id="ID.02594"
           intent="_área-de-la-circunferencia-con-centro-en:prefix($pt)"
          >
         <mi xmlns="http://www.w3.org/1998/Math/MathML"
            id="ID.02595"
            intent=":silent"
            mathvariant="normal"
           >
          <?MarkedContent page="6" ?>⁣
         </mi>
         <msub xmlns="http://www.w3.org/1998/Math/MathML"
            id="ID.02596"
           >
          <mi xmlns="http://www.w3.org/1998/Math/MathML"
             id="ID.02597"
             intent=":silent"
            >
           <?MarkedContent page="6" ?>𝒜
          </mi>
          <mrow xmlns="http://www.w3.org/1998/Math/MathML"
             id="ID.02598"
            >
           <mo xmlns="http://www.w3.org/1998/Math/MathML"
              id="ID.02599"
              intent=":silent"
              lspace="0"
              rspace="0"
             >
            <?MarkedContent page="6" ?>⨀
           </mo>
           <mo xmlns="http://www.w3.org/1998/Math/MathML"
              id="ID.02600"
              intent=":silent"
              lspace="0"
              rspace="0"
              stretchy="false"
             >
            <?MarkedContent page="6" ?>(
           </mo>
           <mi xmlns="http://www.w3.org/1998/Math/MathML"
              id="ID.02601"
              arg="pt"
              intent="_O-"
             >
            <?MarkedContent page="6" ?>𝑂
           </mi>
           <mo xmlns="http://www.w3.org/1998/Math/MathML"
              id="ID.02602"
              intent=":silent"
              lspace="0"
              rspace="0"
              stretchy="false"
             >
            <?MarkedContent page="6" ?>)
           </mo>
          </mrow>
         </msub>
        </mrow>
        <mspace xmlns="http://www.w3.org/1998/Math/MathML"
           id="ID.02603"
           width="9.963pt"
          >
        </mspace>
        <mrow xmlns="http://www.w3.org/1998/Math/MathML"
           id="ID.02604"
           intent="_perímetro-de-la-circunferencia-con-centro-en:prefix($pt)"
          >
         <mi xmlns="http://www.w3.org/1998/Math/MathML"
