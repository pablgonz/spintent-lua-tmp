    <semantic-para xmlns="https://www.latex-project.org/ns/dflt"
       id="ID.02613"
       rolemaps-to="Part"
      >
     <text-block xmlns="https://www.latex-project.org/ns/dflt"
        id="ID.02614"
        xmlns:Layout="http://iso.org/pdf/ssn/Layout"
        Layout:TextAlign="Justify"
        rolemaps-to="P"
       >
      <?MarkedContent page="6" ?>211. Una circunferencia y su radio: 
      <Formula xmlns="http://iso.org/pdf2/ssn"
         id="ID.02615"
         title="math"
         xmlns:Layout="http://iso.org/pdf/ssn/Layout"
         Layout:Placement="Inline"
        >
       <?MarkedContent page="6" ?>
       <math xmlns="http://www.w3.org/1998/Math/MathML"
          id="ID.02616"
         >
        <mi xmlns="http://www.w3.org/1998/Math/MathML"
           id="ID.02617"
           intent=":silent"
           mathvariant="normal"
          >
         <?MarkedContent page="6" ?>⁣
        </mi>
        <mrow xmlns="http://www.w3.org/1998/Math/MathML"
           id="ID.02618"
           intent="_circunferencia"
          >
         <mi xmlns="http://www.w3.org/1998/Math/MathML"
            id="ID.02619"
            intent=":silent"
            mathvariant="normal"
           >
          <?MarkedContent page="6" ?>⁣
         </mi>
         <mi xmlns="http://www.w3.org/1998/Math/MathML"
            id="ID.02620"
            intent=":silent"
            mathvariant="normal"
           >
          <?MarkedContent page="6" ?>⨀
         </mi>
        </mrow>
        <mrow xmlns="http://www.w3.org/1998/Math/MathML"
           id="ID.02621"
           intent="_de-centro-en:prefix($pt)"
          >
         <mi xmlns="http://www.w3.org/1998/Math/MathML"
            id="ID.02622"
            intent=":silent"
            mathvariant="normal"
           >
          <?MarkedContent page="6" ?>⁣
         </mi>
         <mo xmlns="http://www.w3.org/1998/Math/MathML"
            id="ID.02623"
            intent=":silent"
            lspace="0"
            rspace="0"
            stretchy="false"
           >
          <?MarkedContent page="6" ?>(
         </mo>
         <mi xmlns="http://www.w3.org/1998/Math/MathML"
            id="ID.02624"
            arg="pt"
            intent="_O-"
           >
          <?MarkedContent page="6" ?>𝑂
         </mi>
        </mrow>
        <mo xmlns="http://www.w3.org/1998/Math/MathML"
           id="ID.02625"
           intent="_y-radio-"
           lspace="0"
           rspace="0.167em"
          >
         <?MarkedContent page="6" ?>,
        </mo>
        <mn xmlns="http://www.w3.org/1998/Math/MathML"
           id="ID.02626"
           intent="3:number"
          >
         <?MarkedContent page="6" ?>3
        </mn>
        <mo xmlns="http://www.w3.org/1998/Math/MathML"
           id="ID.02627"
           intent=":silent"
           lspace="0"
           rspace="0"
           stretchy="false"
          >
         <?MarkedContent page="6" ?>)
        </mo>
        <mo xmlns="http://www.w3.org/1998/Math/MathML"
           id="ID.02628"
           lspace="0.278em"
           rspace="0.278em"
           stretchy="false"
          >
         <?MarkedContent page="6" ?>⇒
        </mo>
        <mi xmlns="http://www.w3.org/1998/Math/MathML"
           id="ID.02629"
           intent="_radio:nofix"
          >
         <?MarkedContent page="6" ?>𝑟
        </mi>
        <mo xmlns="http://www.w3.org/1998/Math/MathML"
           id="ID.02630"
           lspace="0.278em"
           rspace="0.278em"
          >
         <?MarkedContent page="6" ?>=
        </mo>
        <mn xmlns="http://www.w3.org/1998/Math/MathML"
           id="ID.02631"
          >
         <?MarkedContent page="6" ?>3
        </mn>
       </math>
       <?MarkedContent page="6" ?>
      </Formula>
      <?MarkedContent page="6" ?>.
     </text-block>
    </semantic-para>
    <semantic-para xmlns="https://www.latex-project.org/ns/dflt"
       id="ID.02632"
       rolemaps-to="Part"
      >
     <text-block xmlns="https://www.latex-project.org/ns/dflt"
        id="ID.02633"
        xmlns:Layout="http://iso.org/pdf/ssn/Layout"
        Layout:TextAlign="Justify"
        rolemaps-to="P"
       >
      <?MarkedContent page="6" ?>212. Perímetro en función del radio: 
      <Formula xmlns="http://iso.org/pdf2/ssn"
         id="ID.02634"
         title="math"
         xmlns:Layout="http://iso.org/pdf/ssn/Layout"
         Layout:Placement="Inline"
        >
       <?MarkedContent page="6" ?>
       <math xmlns="http://www.w3.org/1998/Math/MathML"
          id="ID.02635"
         >
        <mi xmlns="http://www.w3.org/1998/Math/MathML"
           id="ID.02636"
           intent=":silent"
           mathvariant="normal"
          >
         <?MarkedContent page="6" ?>⁣
        </mi>
        <mrow xmlns="http://www.w3.org/1998/Math/MathML"
           id="ID.02637"
           intent="_perímetro-de-la-circunferencia-con-centro-en:prefix($pt)"
          >
         <mi xmlns="http://www.w3.org/1998/Math/MathML"
            id="ID.02638"
            intent=":silent"
            mathvariant="normal"
           >
          <?MarkedContent page="6" ?>⁣
         </mi>
         <msub xmlns="http://www.w3.org/1998/Math/MathML"
            id="ID.02639"
           >
          <mi xmlns="http://www.w3.org/1998/Math/MathML"
             id="ID.02640"
             intent=":silent"
            >
           <?MarkedContent page="6" ?>𝒫
          </mi>
          <mrow xmlns="http://www.w3.org/1998/Math/MathML"
             id="ID.02641"
            >
           <mo xmlns="http://www.w3.org/1998/Math/MathML"
              id="ID.02642"
              intent=":silent"
              lspace="0"
