       >
      <?MarkedContent page="2" ?>26. Probabilidad clásica: 
      <Formula xmlns="http://iso.org/pdf2/ssn"
         id="ID.00467"
         title="math"
         xmlns:Layout="http://iso.org/pdf/ssn/Layout"
         Layout:Placement="Inline"
        >
       <?MarkedContent page="2" ?>
       <math xmlns="http://www.w3.org/1998/Math/MathML"
          id="ID.00468"
         >
        <mi xmlns="http://www.w3.org/1998/Math/MathML"
           id="ID.00469"
           intent=":silent"
           mathvariant="normal"
          >
         <?MarkedContent page="2" ?>⁣
        </mi>
        <mrow xmlns="http://www.w3.org/1998/Math/MathML"
           id="ID.00470"
           intent="_probabilidad-de:prefix($a)"
          >
         <mi xmlns="http://www.w3.org/1998/Math/MathML"
            id="ID.00471"
            intent=":silent"
            mathvariant="normal"
           >
          <?MarkedContent page="2" ?>⁣
         </mi>
         <mi xmlns="http://www.w3.org/1998/Math/MathML"
            id="ID.00472"
           >
          <?MarkedContent page="2" ?>𝑃
         </mi>
         <mo xmlns="http://www.w3.org/1998/Math/MathML"
            id="ID.00473"
            lspace="0"
            rspace="0"
            stretchy="false"
           >
          <?MarkedContent page="2" ?>(
         </mo>
         <mrow xmlns="http://www.w3.org/1998/Math/MathML"
            id="ID.00474"
            arg="a"
           >
          <mi xmlns="http://www.w3.org/1998/Math/MathML"
             id="ID.00475"
             intent=":silent"
             mathvariant="normal"
            >
           <?MarkedContent page="2" ?>⁣
          </mi>
          <mi xmlns="http://www.w3.org/1998/Math/MathML"
             id="ID.00476"
            >
           <?MarkedContent page="2" ?>𝐴
          </mi>
         </mrow>
         <mo xmlns="http://www.w3.org/1998/Math/MathML"
            id="ID.00477"
            lspace="0"
            rspace="0"
