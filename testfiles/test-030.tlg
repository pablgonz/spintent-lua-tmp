        rolemaps-to="P"
       >
      <?MarkedContent page="2" ?>26. Probabilidad clásica: 
      <Formula xmlns="http://iso.org/pdf2/ssn"
         id="ID.00481"
         title="math"
         xmlns:Layout="http://iso.org/pdf/ssn/Layout"
         Layout:Placement="Inline"
        >
       <?MarkedContent page="2" ?>
       <math xmlns="http://www.w3.org/1998/Math/MathML"
          id="ID.00482"
         >
        <mi xmlns="http://www.w3.org/1998/Math/MathML"
           id="ID.00483"
           intent=":silent"
           mathvariant="normal"
          >
         <?MarkedContent page="2" ?>⁣
        </mi>
        <mrow xmlns="http://www.w3.org/1998/Math/MathML"
           id="ID.00484"
           intent="_probabilidad-de:prefix($a)"
          >
         <mi xmlns="http://www.w3.org/1998/Math/MathML"
            id="ID.00485"
            intent=":silent"
            mathvariant="normal"
           >
